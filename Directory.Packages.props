<Project>
    <!-- Local Version.props mirrors SDK Build/Common/Version.props; dogfooded AL1602 inspects only the local file -->
    <Import Project="$(MSBuildThisFileDirectory)Version.props"/>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Roslyn -->
    <ItemGroup Label="Roslyn">
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(RoslynAnalyzersVersion)"/>
        <!-- Microsoft.CodeAnalysis.CSharp is SDK-injected; NU1009 forbids a PackageVersion entry for implicit references -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)"/>
    </ItemGroup>

    <!-- Roslyn.Utilities -->
    <ItemGroup Label="Roslyn.Utilities">
        <PackageVersion Include="ANcpLua.Roslyn.Utilities" Version="$(ANcpLuaRoslynUtilitiesVersion)"/>
        <PackageVersion Include="ANcpLua.Roslyn.Utilities.Polyfills" Version="$(ANcpLuaRoslynUtilitiesPolyfillsVersion)"/>
        <PackageVersion Include="ANcpLua.Roslyn.Utilities.Testing" Version="$(ANcpLuaRoslynUtilitiesTestingVersion)"/>
    </ItemGroup>

    <!-- Reference Assemblies -->
    <ItemGroup Label="Reference Assemblies">
        <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="$(BasicReferenceAssembliesVersion)"/>
        <PackageVersion Include="Basic.Reference.Assemblies.NetStandard20" Version="$(BasicReferenceAssembliesVersion)"/>
    </ItemGroup>

    <!-- Analyzer Testing (beta from dotnet-tools feed) -->
    <ItemGroup Label="Analyzer Testing">
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzer.Testing" Version="$(AnalyzerTestingVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="$(AnalyzerTestingVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="$(AnalyzerTestingVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" Version="$(AnalyzerTestingVersion)"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="$(AnalyzerTestingVersion)"/>
    </ItemGroup>

    <!-- Testing (MTP v2): Use Update for SDK-injected packages -->
    <ItemGroup Label="Testing">
        <PackageVersion Update="AwesomeAssertions" Version="$(AwesomeAssertionsVersion)"/>
        <PackageVersion Update="xunit.v3" Version="$(XunitV3Version)"/>
        <PackageVersion Update="xunit.v3.mtp-v2" Version="$(XunitV3Version)"/>
        <PackageVersion Update="Microsoft.Testing.Platform" Version="$(MTPExtensionsVersion)"/>
        <PackageVersion Update="Microsoft.Testing.Platform.MSBuild" Version="$(MTPExtensionsVersion)"/>
    </ItemGroup>

    <!-- SDK-injected analyzers: Use Update (not Include) to override SDK-provided versions -->
    <ItemGroup Label="SDK Analyzers">
        <PackageVersion Update="ANcpLua.Analyzers" Version="$(ANcpLuaAnalyzersVersion)"/>
        <PackageVersion Update="Microsoft.Sbom.Targets" Version="$(SbomTargetsVersion)"/>
        <PackageVersion Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="$(BannedApiAnalyzersVersion)"/>
        <PackageVersion Update="JonSkeet.RoslynAnalyzers" Version="$(JonSkeetAnalyzersVersion)"/>
    </ItemGroup>
</Project>
