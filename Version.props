<Project>
  <!--
    LOCAL OVERRIDE — ANcpLua.Analyzers (NOT the SDK source-of-truth)

    Directory.Packages.props imports this file AFTER ANcpLua.NET.Sdk's own
    Build/Common/Version.props, so every property here wins over SDK truth.

    INVARIANT — an entry belongs here only if it is exactly one of:

      [SDK-UNDEFINED]  the SDK ships no value at all, so this file is the sole
                       source. Deleting the entry breaks restore or the build.
      [AHEAD]          the SDK ships an OLDER value we deliberately outrun.
                       Delete the entry the moment the SDK catches up.

    Everything else is drift. An entry level with SDK truth is a duplicate; an
    entry behind SDK truth is a silent regression wearing an override's clothes.
    Both get deleted and the SDK value flows through untouched.

    Every entry below states which case it is — and, for [AHEAD], the SDK value
    it outruns — so auditing this file is a diff against
    ~/.nuget/packages/ancplua.net.sdk/<ver>/Build/Common/Version.props rather
    than an archaeology exercise. An [AHEAD] entry whose stated SDK value has
    caught up is, by that fact alone, ready to delete.
  -->

  <!-- [SDK-UNDEFINED] The SDK defines no ANcpLuaRoslynUtilities* property at all.
       Consumed by Directory.Packages.props. The renovate comments make each property
       an updatable dependency (custom manager in ANcpLua/github-settings-automation). -->
  <PropertyGroup Label="Roslyn.Utilities">
    <!-- renovate: datasource=nuget depName=ANcpLua.Roslyn.Utilities -->
    <ANcpLuaRoslynUtilitiesVersion>3.0.0</ANcpLuaRoslynUtilitiesVersion>
    <!-- renovate: datasource=nuget depName=ANcpLua.Roslyn.Utilities.Polyfills -->
    <ANcpLuaRoslynUtilitiesPolyfillsVersion>3.0.0</ANcpLuaRoslynUtilitiesPolyfillsVersion>
    <!-- renovate: datasource=nuget depName=ANcpLua.Roslyn.Utilities.Testing -->
    <ANcpLuaRoslynUtilitiesTestingVersion>3.0.0</ANcpLuaRoslynUtilitiesTestingVersion>
  </PropertyGroup>

  <!-- [AHEAD] SDK 3.4.51 ships RoslynVersion and RoslynAnalyzersVersion 5.9.0. The analyzers
       compile against Roslyn 5.12.0, so consumers need a 5.12 compiler (SDK 11.0.100 or later);
       an older compiler reports CS9057 and does not run them. Delete both entries once the SDK
       ships 5.12.0. -->
  <PropertyGroup Label="Roslyn">
    <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.CSharp.Workspaces -->
    <RoslynVersion>5.12.0</RoslynVersion>
    <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.Analyzers -->
    <RoslynAnalyzersVersion>5.12.0</RoslynAnalyzersVersion>
  </PropertyGroup>

  <!-- [AHEAD] SDK 3.4.51 ships 1.8.11, whose Net110 assemblies are a .NET 11 preview. 1.8.15 carries
       the .NET 11 GA reference assemblies the tests compile against. -->
  <PropertyGroup Label="Reference Assemblies">
    <!-- renovate: datasource=nuget depName=Basic.Reference.Assemblies.Net110 -->
    <BasicReferenceAssembliesVersion>1.8.15</BasicReferenceAssembliesVersion>
  </PropertyGroup>

  <!-- [SDK-UNDEFINED] Feeds the five Microsoft.CodeAnalysis.*.Testing package versions
       in Directory.Packages.props. Deleting it silently drops the test project's
       Microsoft.CodeAnalysis.Testing reference and fails the build with CS0234. -->
  <PropertyGroup Label="Analyzer Testing">
    <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.CSharp.Analyzer.Testing -->
    <AnalyzerTestingVersion>1.1.4</AnalyzerTestingVersion>
  </PropertyGroup>
</Project>
