<Project>
  <!--
    LOCAL OVERRIDE — ANcpLua.Analyzers (NOT the SDK source-of-truth)

    Directory.Packages.props imports this file AFTER ANcpLua.NET.Sdk's own
    Build/Common/Version.props, so every property here wins over SDK truth.

    INVARIANT — an entry belongs here only if it is exactly one of:

      [SDK-UNDEFINED]  the SDK ships no value at all, so this file is the sole
                       source. Deleting the entry breaks restore or the build.
      [AHEAD]          the SDK ships an OLDER value we deliberately outrun.
                       Delete the entry the moment the SDK catches up.

    Everything else is drift. An entry level with SDK truth is a duplicate; an
    entry behind SDK truth is a silent regression wearing an override's clothes.
    Both get deleted and the SDK value flows through untouched.

    Every entry below states which case it is — and, for [AHEAD], the SDK value
    it outruns — so auditing this file is a diff against
    ~/.nuget/packages/ancplua.net.sdk/<ver>/Build/Common/Version.props rather
    than an archaeology exercise. An [AHEAD] entry whose stated SDK value has
    caught up is, by that fact alone, ready to delete.
  -->

  <!-- [SDK-UNDEFINED] The SDK defines no ANcpLuaRoslynUtilities* property at all.
       Consumed by Directory.Packages.props. global.json pins ANcpLua.Roslyn.Utilities
       and .Testing as msbuild-sdks — those two must move in lockstep with these. -->
  <PropertyGroup Label="Roslyn.Utilities">
    <ANcpLuaRoslynUtilitiesVersion>2.2.44</ANcpLuaRoslynUtilitiesVersion>
    <ANcpLuaRoslynUtilitiesPolyfillsVersion>2.2.44</ANcpLuaRoslynUtilitiesPolyfillsVersion>
    <ANcpLuaRoslynUtilitiesTestingVersion>2.2.44</ANcpLuaRoslynUtilitiesTestingVersion>
  </PropertyGroup>

  <!-- [SDK-UNDEFINED] Feeds the five Microsoft.CodeAnalysis.*.Testing package versions
       in Directory.Packages.props. Deleting it silently drops the test project's
       Microsoft.CodeAnalysis.Testing reference and fails the build with CS0234. -->
  <PropertyGroup Label="Analyzer Testing">
    <AnalyzerTestingVersion>1.1.4</AnalyzerTestingVersion>
  </PropertyGroup>

  <!-- [AHEAD] SDK 3.4.46 ships 9.4.0. -->
  <PropertyGroup Label="Testing">
    <AwesomeAssertionsVersion>9.6.0</AwesomeAssertionsVersion>
  </PropertyGroup>
</Project>
