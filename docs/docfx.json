{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.md", "**/toc.yml"],
        "exclude": ["_site/**", "api/**.md"]
      },
      {
        "files": ["**/*.md", "**/toc.yml"],
        "src": "api"
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "ANcpLua.Analyzers",
      "_appName": "ANcpLua.Analyzers",
      "_appFooter": "ANcpLua.Analyzers - Roslyn Analyzers for C# Code Quality",
      "_enableSearch": true,
      "_enableNewTab": true
    },
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"]
  }
}
