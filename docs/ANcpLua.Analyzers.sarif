              "shortDescription": {
                "text": "Anonymous function can be made static"
              },
              "fullDescription": {
                "text": "Lambda expressions and anonymous methods that don\u0027t capture variables should be marked \u0027static\u0027 to avoid unnecessary allocations and improve performance."
              },
              "helpUri": "https://github.com/ANcpLua/ANcpLua.Analyzers/blob/main/docs/rules/AL1700_PreferStaticLambda.md",
