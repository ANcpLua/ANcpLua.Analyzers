              "id": "AL1702",
              "name": "AvoidNewtonsoftJson",
              "shortDescription": {
                "text": "Avoid legacy JSON library"
              },
              "fullDescription": {
                "text": "The legacy JSON library should be replaced with System.Text.Json for better performance and native .NET support."
              },
              "helpUri": "https://github.com/ANcpLua/ANcpLua.Analyzers/blob/main/docs/rules/AL1702_AvoidNewtonsoftJson.md",
              "defaultConfiguration": {
