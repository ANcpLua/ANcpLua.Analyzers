            },
            {
              "id": "AL1701",
              "name": "AvoidDateTimeNow",
              "shortDescription": {
                "text": "Avoid DateTime/DateTimeOffset time accessors"
              },
              "fullDescription": {
                "text": "DateTime.Now/UtcNow and DateTimeOffset.Now/UtcNow make code difficult to test. Use TimeProvider.System.GetLocalNow() or GetUtcNow() instead, which can be mocked in tests."
              },
              "helpUri": "https://github.com/ANcpLua/ANcpLua.Analyzers/blob/main/docs/rules/AL1701_AvoidDateTimeNow.md",
              "defaultConfiguration": {
