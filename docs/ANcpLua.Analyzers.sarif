                "category": "Usage"
              }
            },
            {
              "id": "AL1703",
              "name": "UseImplicitTypeWhenApparent",
              "shortDescription": {
                "text": "Use implicit type when type is apparent"
              },
              "fullDescription": {
                "text": "Local variables should use var when the initializer already makes the type apparent. This keeps declarations short without hiding meaning."
              },
              "helpUri": "https://github.com/ANcpLua/ANcpLua.Analyzers/blob/main/docs/rules/AL1703_UseImplicitTypeWhenApparent.md",
