<Project>
    <PropertyGroup>
        <!-- Centralize all build output to artifacts/ -->
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/</ArtifactsPath>
        <BaseOutputPath>$(ArtifactsPath)bin/$(MSBuildProjectName)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(ArtifactsPath)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>

        <!-- Version - single source for all packages -->
        <Version>1.6.11</Version>

        <!-- Package metadata -->
        <Authors>Alexander Nachtmann</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ANcpLua/ANcpLua.Analyzers</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Common warnings:
             NU1701: Package targeting older framework - netstandard2.0 limitation
             CA1034: Nested public types - intentional for analyzer test helpers
             CA2208: ArgumentException instantiation - reviewed and acceptable
             CA1031: Catch general exception - some analyzers need broad catches
             RS2008: Release tracking - not using release tracking
             NOTE: CA1307 REMOVED - now using SDK 1.3.27 StringExtensions polyfill -->
        <NoWarn>$(NoWarn);NU1701;CA1034;CA2208;CA1031;RS2008</NoWarn>

        <!-- Reproducible builds -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- XML documentation for DocFX -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
      Dogfood Mode: ANcpLua.NET.Sdk automatically injects ANcpLua.Analyzers for all projects.
      Rules are enforced at error severity via .editorconfig (see ANcpLua.Analyzers section).
    -->
</Project>