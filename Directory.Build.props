<Project>
    <PropertyGroup>
        <!-- Centralize all build output to artifacts/ -->
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/</ArtifactsPath>
        <BaseOutputPath>$(ArtifactsPath)bin/$(MSBuildProjectName)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(ArtifactsPath)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>

        <!-- Version - single source for all packages -->
        <Version>1.17.0</Version>

        <!-- Package metadata -->
        <Authors>Alexander Nachtmann</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ANcpLua/ANcpLua.Analyzers</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Reproducible builds -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- XML documentation for DocFX -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Align SDK auto-injected Microsoft.CodeAnalysis.CSharp (ANcpLua.NET.Sdk v3.0.0
             SourceGenerators.props auto-detects analyzer/generator projects by name pattern
             and injects an implicit PackageReference). SDK default is 5.0.0 for max IDE host
             compat; this repo tracks $(RoslynVersion) so the injected version stays in sync
             with Microsoft.CodeAnalysis.CSharp.Workspaces in Directory.Packages.props.
             Override unconditionally because SDK sets the default before Directory.Build.props
             runs, so a Condition="' ' == ''" guard would never fire. -->
        <SourceGeneratorRoslynVersion>$(RoslynVersion)</SourceGeneratorRoslynVersion>
    </PropertyGroup>

    <!--
      Dogfood Mode: ANcpLua.NET.Sdk automatically injects ANcpLua.Analyzers for all projects.
      Rules are enforced at error severity via .editorconfig (see ANcpLua.Analyzers section).
    -->
</Project>
