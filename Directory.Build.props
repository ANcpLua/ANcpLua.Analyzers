<Project>
    <PropertyGroup>
        <!-- Centralize all build output to artifacts/ -->
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts/</ArtifactsPath>
        <BaseOutputPath>$(ArtifactsPath)bin/$(MSBuildProjectName)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(ArtifactsPath)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>

        <!-- Version - single source for all packages -->
        <Version>1.17.0</Version>

        <!-- Package metadata -->
        <Authors>Alexander Nachtmann</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ANcpLua/ANcpLua.Analyzers</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Reproducible builds -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- XML documentation for DocFX -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Keep SDK-injected Microsoft.CodeAnalysis.CSharp aligned with Workspaces in Directory.Packages.props; unconditional because SDK sets the default before this file runs -->
        <SourceGeneratorRoslynVersion>$(RoslynVersion)</SourceGeneratorRoslynVersion>
    </PropertyGroup>
</Project>
