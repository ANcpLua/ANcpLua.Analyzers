<Project Sdk="ANcpLua.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>

        <!-- REQUIRED: Break circular dependency (SDK auto-injects this analyzer) -->
        <PackageId>Dummy</PackageId>

        <!-- Generate XML documentation for DocFX -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Analyzer package settings -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <DevelopmentDependency>true</DevelopmentDependency>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>89 Roslyn diagnostics for modern C# in 9 domain-banded ID ranges (AL1000–AL1899) — correctness pitfalls, ASP.NET Core/Aspire patterns, Roslyn utilities, async/threading reliability, AOT/trim safety, Roslyn-author hygiene, package versioning, style, and agent-tool governance. Includes 37 automatic code fixes.</Description>

        <!-- Analyzers don't have debug symbols - disable snupkg generation -->
        <IncludeSymbols>false</IncludeSymbols>

        <!-- Suppress analyzer rules:
             RS1025/RS1026/RS1041: Analyzer registration patterns - intentional design
             RS0030: Banned APIs - analyzer needs access to banned patterns to detect them
             CA2249: Use Contains - ns2.0 lacks Contains(char, StringComparison), must use IndexOf
             IDE0055: Multi-TFM formatting conflicts (dotnet format creates TFM merge markers) -->
        <NoWarn>$(NoWarn);RS1025;RS1026;RS1041;RS0030;IDE0055;CA2249</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Microsoft.CodeAnalysis"/>
        <Using Include="Microsoft.CodeAnalysis.CSharp"/>
        <Using Include="Microsoft.CodeAnalysis.CSharp.Syntax"/>
        <Using Include="Microsoft.CodeAnalysis.Diagnostics"/>
        <Using Include="Microsoft.CodeAnalysis.Operations"/>
        <Using Include="System.Collections.Concurrent"/>
        <Using Include="System.Collections.Immutable"/>
        <Using Include="ANcpLua.Roslyn.Utilities"/>
        <Using Include="ANcpLua.Roslyn.Utilities.Analyzers"/>
        <Using Include="ANcpLua.Roslyn.Utilities.Contexts"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Runtime package - bundled into analyzer package via _AddAnalyzersToPackage target -->
        <PackageReference Include="ANcpLua.Roslyn.Utilities" PrivateAssets="all"/>
        <!-- Source-only polyfills for netstandard2.0 (IsExternalInit, etc.) -->
        <PackageReference Include="ANcpLua.Roslyn.Utilities.Polyfills" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Microsoft.CodeAnalysis.CSharp is auto-injected by ANcpLua.NET.Sdk's SourceGenerators.props
             (detected via project-name pattern "*Analyzer*"), pinned to $(SourceGeneratorRoslynVersion)
             for IDE host compat. Explicit reference here would duplicate. -->
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="Resources.resx"/>
        <EmbeddedResource Update="Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/"/>
        <!-- Include build props for analyzer configuration (exposes MSBuild properties to analyzers) -->
        <None Include="build/ANcpLua.Analyzers.props" Pack="true" PackagePath="build/"/>
    </ItemGroup>

    <!-- AnalyzerReleases files are auto-added as AdditionalFiles by Microsoft.CodeAnalysis.Analyzers
         when they exist in the project directory (line 335-340 of its .targets file).
         Do NOT add them here — it causes duplicates in Rider's "Show All Files" view. -->

    <!--
      After-build drift guard. Every `dotnet build` of this project invokes the
      DocsGenerator twice via Exec:
        1. 'enforce-ids' mode  : verify every analyzer/codefix class name, XML doc
           summary, and DiagnosticId const matches the runtime DiagnosticDescriptor.
        2. 'check' mode        : verify docs/ANcpLua.Analyzers.md, per-rule pages,
           editorconfig profiles, HelpLinkUri values, and the SARIF manifest still
           match what the generator would emit.

      Gating:
        * _AlInsideConsistencyCheck: recursion-break. The nested `dotnet run`
          rebuilds the DocsGenerator, which transitively re-evaluates this
          analyzer csproj. Without the sentinel, AfterBuild fires inside the
          nested build and detonates into hundreds of duplicated errors.
        * TargetFramework == netstandard2.0: this project multi-targets
          (net10.0;netstandard2.0). MSBuild fires AfterBuild once per TFM, in
          parallel under -m:N. On Windows that races on the obj/DocsGenerator.dll
          write lock (CS2012). Pin to the netstandard2.0 inner build so the
          drift check runs exactly once per outer `dotnet build`.

      Opt out with -p:SkipAnalyzerConsistencyCheck=true during inner-loop iteration.
      CI must leave it on.
    -->
    <Target Name="_VerifyAnalyzerConsistency"
            AfterTargets="Build"
            Condition="'$(SkipAnalyzerConsistencyCheck)' != 'true' AND '$(_AlInsideConsistencyCheck)' != 'true' AND '$(TargetFramework)' == 'netstandard2.0'">
        <PropertyGroup>
            <_DocsGenProject>$(MSBuildThisFileDirectory)../../tools/ANcpLua.Analyzers.DocsGenerator/ANcpLua.Analyzers.DocsGenerator.csproj</_DocsGenProject>
        </PropertyGroup>
        <Exec Command="dotnet run --project &quot;$(_DocsGenProject)&quot; --configuration $(Configuration) -- --enforce-ids"
              WorkingDirectory="$(MSBuildThisFileDirectory)../.."
              EnvironmentVariables="_AlInsideConsistencyCheck=true"/>
        <Exec Command="dotnet run --project &quot;$(_DocsGenProject)&quot; --configuration $(Configuration) -- --check"
              WorkingDirectory="$(MSBuildThisFileDirectory)../.."
              EnvironmentVariables="_AlInsideConsistencyCheck=true"/>
    </Target>

    <!-- CRITICAL: Pack ALL analyzer assemblies including dependencies (netstandard2.0 only) -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>
        <!-- Ensure dependencies are copied to output for bundling -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <Target Name="_AddAnalyzersToPackage" Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <ItemGroup>
            <!-- Analyzer assemblies -->
            <TfmSpecificPackageFile Include="$(OutputPath)ANcpLua.Analyzers.dll" PackagePath="analyzers/dotnet/cs"/>
            <TfmSpecificPackageFile Include="$(ArtifactsPath)bin/ANcpLua.Analyzers.CodeFixes/release_netstandard2.0/ANcpLua.Analyzers.CodeFixes.dll" PackagePath="analyzers/dotnet/cs"/>
            <!-- Bundle Roslyn.Utilities dependency (required for analyzer runtime) -->
            <TfmSpecificPackageFile Include="$(OutputPath)ANcpLua.Roslyn.Utilities.dll" PackagePath="analyzers/dotnet/cs"/>

            <!--
              Pack the buildTransitive props that exposes $(AlAnalysisMode) to consumers.
              NuGet auto-imports buildTransitive/{PackageId}.props on restore; the props
              file's ItemGroups switch on the property value and append the matching
              editorconfig profile to $(EditorConfigFiles). Editorconfig profiles live
              at docs/editorconfig/ (single source of truth, browsable on GitHub) and
              ship under buildTransitive/editorconfig/ inside the NuGet so the props's
              $(MSBuildThisFileDirectory) resolves alongside them.
            -->
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)buildTransitive/ANcpLua.Analyzers.props"
                                    PackagePath="buildTransitive/ANcpLua.Analyzers.props"/>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/Default.editorconfig"
                                    PackagePath="buildTransitive/editorconfig/Default.editorconfig"/>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/AllRulesAsErrors.editorconfig"
                                    PackagePath="buildTransitive/editorconfig/AllRulesAsErrors.editorconfig"/>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)../../docs/editorconfig/AllRulesDisabled.editorconfig"
                                    PackagePath="buildTransitive/editorconfig/AllRulesDisabled.editorconfig"/>
        </ItemGroup>
    </Target>
</Project>
